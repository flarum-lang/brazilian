{
	"name": "flarum-lang/brazilian",
	"description": "Portuguese (Brazil) Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/brazilian",
	"license": "MIT",
	"authors": [
		{
			"name": "ram0ng1",
			"homepage": "https://github.com/ram0ng1",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/brazilian/issues",
		"forum": "https://discuss.flarum.org/d/18543",
		"source": "https://github.com/flarum-lang/brazilian"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Portuguese (Brazil)",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#55a667",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "pt-BR",
			"title": "Português (Brasil)"
		}
	}
}
